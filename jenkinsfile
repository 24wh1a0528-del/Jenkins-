
pipeline {
    agent any

    tools {
        maven 'maven'
        jdk 'java'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/24wh1a0528-del/Jenkins.git',
                    credentialsId: 'pipeline key'
            }
        }

        stage('Build & Test') {
            steps {
                bat 'mvn clean install'
            }
        }
    }
}
